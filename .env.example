# 복사해서 .env.local(로컬) 또는 Cloudflare Pages의 환경 변수로 설정하세요. 모두 NEXT_PUBLIC_ 접두사라 빌드 때 사이트에 포함됩니다(비밀 값 아님).

# 실제 도메인 (필수: canonical, sitemap, hreflang, 구조화 데이터에 사용)
NEXT_PUBLIC_SITE_URL=https://example.com

# 문의 이메일 (기본값이 있음)
NEXT_PUBLIC_CONTACT_EMAIL=contact@anypictoanypic.com

# 검색엔진 소유 확인 (배포 후 각 서비스에서 받은 값)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# 애드센스: 게시자 ID만 넣으면 승인 전에도 확인용 meta 태그가 출력됩니다.
# 승인 후 ADS_ENABLED=true 와 슬롯 ID를 넣으면 광고가 켜집니다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
